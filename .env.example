# Local-only secrets. Run ./scripts/init-env.sh to generate the first two values.
JUPYTER_TOKEN=
MCP_TOKEN=

# OpenAI Secure MCP Tunnel. Leave blank to run local Jupyter + MCP only.
CONTROL_PLANE_TUNNEL_ID=
CONTROL_PLANE_API_KEY=

# Public localhost ports presented to Windows through WSL localhostForwarding.
JUPYTER_PORT=8888
MCP_PORT=4040
TUNNEL_HEALTH_PORT=8080

# Private Docker publish ports inside the CoKernel WSL distro. Do not browse these
# from Windows directly; systemd-socket-proxyd bridges the public ports above.
JUPYTER_BACKEND_PORT=18888
MCP_BACKEND_PORT=14040
TUNNEL_HEALTH_BACKEND_PORT=18080

# Runtime configuration.
WORKSPACE_DIR=./workspace
COKERNEL_SYNC_WORKSPACE=1

# Pinned control-path image. Change deliberately.
TUNNEL_CLIENT_IMAGE=ghcr.io/openai/tunnel-client:v0.0.13
GPU_TEST_IMAGE=nvidia/cuda:12.8.1-base-ubuntu24.04
