{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoKernel",
  "version": "1.0.0-alpha.0",
  "identifier": "com.ymhome.cokernel",
  "build": { "beforeDevCommand": "pnpm dev", "beforeBuildCommand": "pnpm build", "devUrl": "http://127.0.0.1:1420", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "CoKernel", "width": 1180, "height": 780, "minWidth": 720, "minHeight": 520 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'" }
  },
  "bundle": { "active": false }
}
